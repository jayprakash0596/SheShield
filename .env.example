# SheShield Environment Configuration
# Copy this file to .env and adjust variables as needed for local development

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_e9f2a8c14b7e

# Database Configuration
# Neon PostgreSQL cloud database or local SQLite:
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///sheshield.db

# Security Settings
WTF_CSRF_ENABLED=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_SAMESITE=Lax

# Notification Services (Mocked by default for safe local development)
SMS_PROVIDER=mock  # Options: mock, twilio, fast2sms (requires external credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rate Limiting & Audit
LOGIN_RATE_LIMIT=10  # Max attempts per window
